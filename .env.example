APP_ENVIRONMENT=development
APP_DATABASE_URL=postgresql+psycopg://pdf_converter:pdf_converter@postgres/pdf_converter
APP_REDIS_URL=redis://redis:6379/0
APP_STORAGE_PATH=/data/conversions
APP_JOB_TTL_MINUTES=60
APP_MAX_UPLOAD_BYTES=10485760
APP_MAX_PDF_PAGES=5
APP_TOKEN_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
APP_RQ_QUEUE_NAME=conversions
APP_PREVIEW_DPI=96
APP_LIBREOFFICE_BINARY=soffice
APP_LIBREOFFICE_TIMEOUT_SECONDS=30
